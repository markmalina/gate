{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alphacenter:gate:delivery-fact:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fact_ref", "command_ref", "idempotency_key", "observed_at", "installation_ref", "conversation_ref", "destination_ref", "route_generation", "attempt", "status", "consumer_commit_ref", "reconciliation_ref"],
  "properties": {
    "schema_version": {"const": "gate.delivery.fact.v1"},
    "fact_ref": {"type": "string", "pattern": "^fact:[A-Za-z0-9._~-]{8,128}$"},
    "command_ref": {"type": "string", "pattern": "^command:[A-Za-z0-9._~-]{8,128}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:~/-]{7,255}$"},
    "observed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]\\.[0-9]{3}Z$"},
    "installation_ref": {"type": "string", "pattern": "^installation:[A-Za-z0-9._~-]{8,128}$"},
    "conversation_ref": {"type": "string", "pattern": "^conversation:[A-Za-z0-9._~-]{8,128}$"},
    "destination_ref": {"type": "string", "pattern": "^destination:[A-Za-z0-9._~-]{8,128}$"},
    "route_generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 3},
    "status": {"enum": ["committed", "duplicate", "rejected", "retryable", "unknown"]},
    "consumer_commit_ref": {"type": ["string", "null"], "pattern": "^commit:[A-Za-z0-9._~-]{8,128}$"},
    "reconciliation_ref": {"type": ["string", "null"], "pattern": "^reconciliation:[A-Za-z0-9._~-]{8,128}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"enum": ["committed", "duplicate"]}}}, "then": {"properties": {"consumer_commit_ref": {"type": "string"}, "reconciliation_ref": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "unknown"}}}, "then": {"properties": {"consumer_commit_ref": {"type": "null"}, "reconciliation_ref": {"type": "string"}}}},
    {"if": {"properties": {"status": {"enum": ["rejected", "retryable"]}}}, "then": {"properties": {"consumer_commit_ref": {"type": "null"}, "reconciliation_ref": {"type": "null"}}}}
  ]
}
