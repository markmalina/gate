{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:alphacenter:gate:message-received:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_ref", "idempotency_key", "occurred_at", "installation_ref", "conversation_ref", "actor_ref", "destination_ref", "route_generation", "content"],
  "properties": {
    "schema_version": {"const": "gate.message.received.v1"},
    "event_ref": {"type": "string", "pattern": "^event:[A-Za-z0-9._~-]{8,128}$"},
    "idempotency_key": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:~/-]{7,255}$"},
    "occurred_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-5][0-9]\\.[0-9]{3}Z$"},
    "installation_ref": {"type": "string", "pattern": "^installation:[A-Za-z0-9._~-]{8,128}$"},
    "conversation_ref": {"type": "string", "pattern": "^conversation:[A-Za-z0-9._~-]{8,128}$"},
    "actor_ref": {"type": "string", "pattern": "^actor:[A-Za-z0-9._~-]{8,128}$"},
    "destination_ref": {"type": "string", "pattern": "^destination:[A-Za-z0-9._~-]{8,128}$"},
    "route_generation": {"type": "integer", "minimum": 1, "maximum": 2147483647},
    "content": {"$ref": "#/$defs/content"}
  },
  "$defs": {
    "content": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "text"], "properties": {"kind": {"const": "text"}, "text": {"type": "string", "minLength": 1, "maxLength": 32768}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "object_ref", "sha256", "size_bytes", "content_type"], "properties": {"kind": {"const": "media_ref"}, "object_ref": {"type": "string", "pattern": "^object:[A-Za-z0-9._~-]{8,128}$"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "size_bytes": {"type": "integer", "minimum": 1, "maximum": 26214400}, "content_type": {"type": "string", "minLength": 3, "maxLength": 127}}}
      ]
    }
  }
}
