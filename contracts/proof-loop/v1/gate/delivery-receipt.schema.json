{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://alphacenter.dev/contracts/proof-loop/v1/gate/delivery-receipt.schema.json",
  "title": "BECOME Proof Loop Gate delivery receipt",
  "type": "object",
  "required": [
    "schema_version", "receipt_type", "effect_id", "correlation_id", "idempotency_key", "mode",
    "provider", "operation", "effect_state", "delivery_outcome", "attempt", "retry_policy", "payload_ref"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "receipt_type": {"const": "gate.delivery_receipt"},
    "effect_id": {"type": "string", "pattern": "^effect_[A-Za-z0-9_-]+$"},
    "correlation_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 8},
    "mode": {"enum": ["LIVE", "TEST", "CONTROLLED", "SIMULATED"]},
    "provider": {"enum": ["telegram_bot", "telegram_business", "meta_instagram"]},
    "operation": {"enum": ["message", "private_reply", "content_publish", "group_invite", "group_pin", "membership_check"]},
    "effect_state": {"enum": ["reserved", "in_flight", "settled", "unknown"]},
    "delivery_outcome": {"enum": ["pending", "delivered", "failed", "rejected", "not_attempted"]},
    "attempt": {"type": "integer", "const": 1},
    "payload_ref": {"type": "string", "pattern": "^payload_[A-Za-z0-9_-]+$"},
    "consent_receipt_ref": {"type": "string", "pattern": "^consent_[A-Za-z0-9_-]+$"},
    "provider_receipt_ref": {"type": "string", "pattern": "^provider_[A-Za-z0-9_-]+$"},
    "retry_policy": {
      "type": "object",
      "required": ["automatic_retry", "reconciliation_required"],
      "properties": {
        "automatic_retry": {"const": false},
        "reconciliation_required": {"type": "boolean"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"properties": {"delivery_outcome": {"const": "delivered"}}, "required": ["delivery_outcome"]},
      "then": {
        "properties": {"effect_state": {"const": "settled"}},
        "required": ["provider_receipt_ref"]
      }
    },
    {
      "if": {"properties": {"effect_state": {"const": "unknown"}}, "required": ["effect_state"]},
      "then": {
        "properties": {
          "delivery_outcome": {"const": "pending"},
          "retry_policy": {"properties": {"reconciliation_required": {"const": true}}}
        }
      }
    },
    {
      "if": {"properties": {"mode": {"const": "SIMULATED"}}, "required": ["mode"]},
      "then": {"not": {"required": ["provider_receipt_ref"]}}
    }
  ],
  "additionalProperties": false
}
