FROM python:3.12-slim@sha256:c3d81d25b3154142b0b42eb1e61300024426268edeb5b5a26dd7ddf64d9daf28

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

# Deliberately copy only the provider-disabled standard-library I4 module.
COPY app/become_i4_service.py /app/app/become_i4_service.py

USER 65532:65532

EXPOSE 8000

CMD ["python", "-m", "app.become_i4_service"]
