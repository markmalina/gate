DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=gate_m_bot
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_API_BASE_URL=https://api.telegram.org
GATE_ENV=development
GATE_DEFAULT_MODE=manual
ACTION_BEARER_TOKEN=
ADMIN_BEARER_TOKEN=

# MCP is disabled unless every containment setting below is explicitly configured.
GATE_MCP_ENABLED=false
MCP_AUTH_MODE=temporary_bearer
MCP_AUTHORIZATION_SERVER=
MCP_PUBLIC_RESOURCE_URL=
MCP_OAUTH_JWKS_URL=
MCP_OAUTH_ALLOWED_ALGORITHMS=RS256
MCP_OAUTH_CLOCK_SKEW_SECONDS=30
MCP_OAUTH_WORKSPACE_CLAIM=gate_workspace_id
MCP_OAUTH_ACCOUNT_IDS_CLAIM=gate_account_ids
MCP_OAUTH_PROJECT_IDS_CLAIM=gate_project_ids
MCP_READ_BEARER_TOKEN=
MCP_READ_WORKSPACE_ID=
MCP_READ_ACCOUNT_IDS=
MCP_READ_PROJECT_IDS=

# The separate Alpha bot and both model egress gates default to disabled.
TELEGRAM_ALPHA_BOT_TOKEN=
TELEGRAM_ALPHA_BOT_USERNAME=AlphaViaBot
TELEGRAM_ALPHA_WEBHOOK_SECRET=
GATE_TELEGRAM_WORKER_ENABLED=false
GATE_ALPHA_CONNECTOR_ENABLED=false
GATE_ALPHA_SHADOW_WORKER_ENABLED=false
GATE_ALPHA_CANARY_ENABLED=false
GATE_ALPHA_DELIVERY_ENABLED=false
GATE_ALPHA_PRIVACY_MODE_CONFIRMED=false
GATE_ALPHA_GROUP_CAPACITY=100
GATE_ALPHA_MEMBERSHIP_REPLAY_LIMIT=0

# Exact private Beta workflow OIDC trust; no long-lived GitHub secret.
GATE_BETA_CHECKPOINT_OIDC_ENABLED=true
GATE_BETA_CHECKPOINT_OIDC_AUDIENCE=gate-beta-checkpoint-v1
GATE_BETA_CHECKPOINT_OIDC_REPOSITORY=markmalina/beta
GATE_BETA_CHECKPOINT_OIDC_REPOSITORY_ID=1312239432
GATE_BETA_CHECKPOINT_OIDC_REPOSITORY_OWNER_ID=23397294
GATE_BETA_CHECKPOINT_OIDC_REF=refs/heads/main
GATE_BETA_CHECKPOINT_OIDC_WORKFLOW_REF=markmalina/beta/.github/workflows/checkpoint-context.yml@refs/heads/main
GATE_AGENT_BUNDLE_ROOT=agent_bundles
OPENAI_API_KEY=
OPENAI_API_BASE_URL=https://api.openai.com/v1
GATE_ALPHA_MODEL_RUNTIME_ENABLED=false
GATE_ALPHA_MODEL_DATA_GATE_APPROVED=false
GATE_ALPHA_MODEL_MAX_OUTPUT_TOKENS=512
GATE_ALPHA_MODEL_TIMEOUT_SECONDS=30

# Personal Universal Mayak remains separately disabled until owner-only activation.
GATE_UNIVERSAL_MAYAK_RUNTIME_ENABLED=false
GATE_UNIVERSAL_MAYAK_DELIVERY_ENABLED=false
GATE_UNIVERSAL_MAYAK_MODEL_DATA_GATE_APPROVED=false
GATE_UNIVERSAL_MAYAK_MODEL_PROFILE=gpt-5.6-luna
GATE_UNIVERSAL_MAYAK_MAX_OUTPUT_TOKENS=512
GATE_UNIVERSAL_MAYAK_TIMEOUT_SECONDS=30
